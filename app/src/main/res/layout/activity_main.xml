<?xml version="1.0" encoding="utf-8"?>
<!--
    Blackmagic Camera style root layout.

    Structure (bottom-up):
      TextureView   -> full-screen live camera preview
      BmOverlayView -> zebras / false color / focus peaking overlay
      top bar       -> LENS, FPS, SHTR, ISO, WB selectors
      center dial   -> floating SeekBar for ISO / Shutter / WB / Zoom
      bottom bar    -> MEDIA, record button, format, audio meters
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bmRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bm_black">

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <com.example.camara.BmOverlayView
        android:id="@+id/bmOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.camara.BmTopBar
        android:id="@+id/bmTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:padding="14dp"
        android:background="@color/bm_bg" />

    <com.example.camara.BmCenterDial
        android:id="@+id/bmCenterDial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <com.example.camara.BmBottomBar
        android:id="@+id/bmBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="14dp"
        android:background="@color/bm_bg" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:textColor="@color/bm_red"
        android:textSize="12sp"
        android:padding="8dp" />

</FrameLayout>