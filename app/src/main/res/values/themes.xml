<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Blackmagic Camera theme: full-screen immersive, no action bar, dark -->
    <style name="Theme.Camara" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/bm_panel</item>
        <item name="colorPrimaryVariant">@color/bm_bg</item>
        <item name="colorOnPrimary">@color/bm_white</item>
        <item name="colorSecondary">@color/bm_green</item>
        <item name="colorSecondaryVariant">@color/bm_green_dim</item>
        <item name="colorOnSecondary">@color/bm_black</item>
        <item name="android:statusBarColor">@color/bm_bg</item>
        <item name="android:navigationBarColor">@color/bm_bg</item>
        <item name="android:windowBackground">@color/bm_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>